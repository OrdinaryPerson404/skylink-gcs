              <HBox spacing="8">
                <VBox styleClass="settings-field" HBox.hgrow="ALWAYS"><Label text="串口号" styleClass="settings-field-label"/><ComboBox fx:id="serialPortCombo"/></VBox>
                <VBox styleClass="settings-field"><Label text="波特率" styleClass="settings-field-label"/><ComboBox fx:id="baudRateCombo"/></VBox>
              </HBox>
              <VBox styleClass="settings-field">
                <Label text="MAVLink 消息频率" styleClass="settings-field-label"/>
                <HBox spacing="6" styleClass="mavlink-freq-row">
                  <VBox alignment="CENTER" styleClass="freq-item">
                    <Label text="心跳" styleClass="freq-label"/>
                    <TextField fx:id="freqHeartbeat" text="1" maxWidth="50" alignment="CENTER"/>
                    <Label text="Hz" styleClass="freq-unit"/>
                  </VBox>
                  <VBox alignment="CENTER" styleClass="freq-item">
                    <Label text="姿态" styleClass="freq-label"/>
                    <TextField fx:id="freqAttitude" text="50" maxWidth="50" alignment="CENTER"/>
