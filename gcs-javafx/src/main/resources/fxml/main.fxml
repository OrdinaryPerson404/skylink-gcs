                </graphic>
              </Label>
              <Label fx:id="chHum" text="湿度" styleClass="wave-channel,enabled" onMouseClicked="#onToggleChannel">
                <graphic>
                  <Region styleClass="ch-dot" style="-fx-background-color: #34d399; -fx-opacity: 1;"/>
                </graphic>
              </Label>
              <Label fx:id="chPres" text="气压" styleClass="wave-channel,enabled" onMouseClicked="#onToggleChannel">
