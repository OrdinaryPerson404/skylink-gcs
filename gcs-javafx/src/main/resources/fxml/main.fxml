<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.SVGPath?>
<?import cn.edu.nuaa.gcs.ui.MapCanvas?>

<VBox fx:id="root" prefWidth="1400" prefHeight="900" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.edu.nuaa.gcs.ui.MainController">
  <!-- ===== Top Navigation Bar ===== -->
  <HBox styleClass="topnav" prefHeight="40" spacing="8" alignment="CENTER_LEFT">
    <HBox alignment="CENTER" spacing="6" styleClass="brand-box">
      <Region styleClass="brand-logo"/>
      <Label text="SkyLink " styleClass="brand-text"/>
      <Label text="天链" styleClass="brand-accent"/>
    </HBox>
    <MenuBar styleClass="menu-bar">
      <Menu text="文件">
        <MenuItem text="导入任务 XML" onAction="#onImportXml"/>
        <MenuItem text="导出任务 XML" onAction="#onExportXml"/>
        <SeparatorMenuItem/>
        <MenuItem text="导出飞行日志 CSV" onAction="#onExportLogCsv"/>
        <MenuItem text="导入飞行日志 CSV" onAction="#onImportLogCsv"/>
      </Menu>
      <Menu text="任务">
        <MenuItem text="新增航点" onAction="#onAddWaypoint"/>
        <MenuItem text="删除航点" onAction="#onDeleteWaypoint"/>
        <MenuItem text="清空航点" onAction="#onClearWaypoints" style="-fx-text-fill: #ef4444;"/>
        <SeparatorMenuItem/>
        <MenuItem text="路径预览" onAction="#onPreviewPath"/>
        <MenuItem text="路径优化" onAction="#onOptimizePath"/>
        <MenuItem text="冲突检测" onAction="#onCheckConflicts"/>
        <MenuItem text="空域校验" onAction="#onAirspaceCheck"/>
        <SeparatorMenuItem/>
        <MenuItem text="上传至 E1" onAction="#onUploadToE1" disable="true" fx:id="menuUploadE1" style="-fx-text-fill: #f59e0b;"/>
        <MenuItem text="开始自动任务" onAction="#onStartAutoMission" disable="true" fx:id="menuAutoMission" style="-fx-text-fill: #f59e0b;"/>
      </Menu>
      <Menu text="视图">
        <MenuItem text="任务与监控" onAction="#onGoMissionTab"/>
        <MenuItem text="数据与日志" onAction="#onGoDataTab"/>
        <MenuItem text="系统设置" onAction="#onGoSettingsTab"/>
        <MenuItem text="算法分析" onAction="#onGoAlgoTab"/>
        <SeparatorMenuItem/>
        <MenuItem text="切换主题" onAction="#onToggleTheme"/>
      </Menu>
      <Menu text="系统设置" onShowing="#onMenuSettingsShowing"/>
      <Menu text="帮助">
        <MenuItem text="关于 SkyLink" onAction="#onShowAbout"/>
        <MenuItem text="快捷键" onAction="#onShowShortcuts"/>
      </Menu>
    </MenuBar>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox alignment="CENTER" styleClass="mode-switcher">
      <ToggleButton fx:id="e1Btn" text="E1 实机" onAction="#onE1Mode" styleClass="mode-btn,mode-e1">
        <toggleGroup><ToggleGroup fx:id="modeGroup"/></toggleGroup>
      </ToggleButton>
      <ToggleButton fx:id="phoneBtn" text="手机辅助" onAction="#onPhoneMode" styleClass="mode-btn,mode-phone">
        <toggleGroup><fx:reference source="modeGroup"/></toggleGroup>
      </ToggleButton>
    </HBox>
    <Region fx:id="connDot" styleClass="conn-dot,on"/>
    <Label fx:id="connDetail" text="已连接 · COM3 115200" styleClass="conn-detail"/>
    <Label fx:id="clockLabel" text="--:--:--" styleClass="clock-label"/>
    <Button text="主题" onAction="#onToggleTheme" styleClass="theme-btn"/>
  </HBox>

  <!-- ===== Workspace Tabs ===== -->
  <TabPane fx:id="workspaceTabs" VBox.vgrow="ALWAYS" styleClass="workspace-tabs">
    <!-- ===== Tab 1: 任务与监控 ===== -->
    <Tab fx:id="missionTab" closable="false">
      <graphic><SVGPath content="M3 17L8 12L12 16L21 7M21 5a2 2 0 1 0 0 4a2 2 0 0 0 0-4" styleClass="svg-line,svg-14"/></graphic>
      <text>任务与监控</text>
      <VBox fillWidth="true" VBox.vgrow="ALWAYS">
        <HBox fx:id="safeBanner" styleClass="safe-banner" visible="false" managed="false">
          <Label text="安全测试模式 · 仅限无桨/架台测试 · 实机控制默认只读" styleClass="safe-banner-text">
          <graphic><SVGPath content="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" styleClass="svg-line,svg-12,svg-warn"/></graphic>
        </Label>
          <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
            <Button fx:id="btnEnterCtrl" text="进入控制测试" styleClass="safe-action" onAction="#onEnterCtrlTest"/>
            <Button fx:id="btnExitCtrl" text="退出控制测试" styleClass="safe-action,danger" visible="false" managed="false" onAction="#onExitCtrlTest"/>
          </HBox>
        </HBox>
        <SplitPane fx:id="mainSplit" dividerPositions="0.22" VBox.vgrow="ALWAYS">
          <!-- Left Panel - Enhanced -->
          <VBox fx:id="leftPanel" minWidth="260" prefWidth="280" styleClass="left-panel">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
              <VBox>
                <!-- E1 Flight Controller Status -->
                <VBox fx:id="e1StatusBox" styleClass="lp-section" visible="false" managed="false">
                  <HBox styleClass="lp-section-head" alignment="CENTER_LEFT">
                    <Label text="E1 飞控" styleClass="lp-title"/>
                    <Label text="飞控" styleClass="src-tag,e1"/>
                  </HBox>
                  <VBox styleClass="lp-section-body" spacing="4">
                    <Label fx:id="e1ConnBanner" text="--" styleClass="dev-conn-banner"/>
                    <HBox styleClass="dev-row"><Label text="IP 地址" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1IpVal" text="--" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="UDP 端口" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1PortVal" text="--" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="通信延迟" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1LatencyVal" text="--" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="解锁状态" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1ArmedVal" text="未解锁" styleClass="dev-val,off"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="油门" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1ThrottleVal" text="0%" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="控制来源" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1CtrlSrcVal" text="--" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="心跳" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1HeartbeatVal" text="--" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                    <HBox styleClass="dev-row"><Label text="链路质量" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="e1LinkQualityVal" text="--" styleClass="dev-val"/><Label text="E1" styleClass="src-tag,e1"/></HBox>
                  </VBox>
                </VBox>

                <!-- Phone Companion Status -->
                <VBox fx:id="phoneStatusBox" styleClass="lp-section" visible="false" managed="false">
                  <HBox styleClass="lp-section-head" alignment="CENTER_LEFT">
                    <Label text="手机伴随定位" styleClass="lp-title"/>
                    <Label text="手机" styleClass="src-tag,phone"/>
                  </HBox>
                  <VBox styleClass="lp-section-body" spacing="4">
                    <Label fx:id="phoneConnBanner" text="--" styleClass="dev-conn-banner"/>
                    <HBox styleClass="dev-row"><Label text="GPS 定位" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="phoneGpsVal" text="未接入" styleClass="dev-val,off"/><Label text="手机" styleClass="src-tag,phone"/></HBox>
                    <HBox styleClass="dev-row"><Label text="定位精度" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="phoneGpsAccVal" text="--" styleClass="dev-val"/><Label text="手机" styleClass="src-tag,phone"/></HBox>
                    <HBox styleClass="dev-row"><Label text="当前位置" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="phonePosVal" text="--" styleClass="dev-val"/><Label text="手机" styleClass="src-tag,phone"/></HBox>
                    <HBox styleClass="dev-row"><Label text="罗盘" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="phoneCompassVal" text="--" styleClass="dev-val,off"/><Label text="手机" styleClass="src-tag,phone"/></HBox>
                    <HBox styleClass="dev-row"><Label text="气压计" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="phoneBaroVal" text="--" styleClass="dev-val,off"/><Label text="手机" styleClass="src-tag,phone"/></HBox>
                    <HBox styleClass="dev-row"><Label text="最后更新" styleClass="dev-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="phoneLastUpdateVal" text="--" styleClass="dev-val"/><Label text="手机" styleClass="src-tag,phone"/></HBox>
                  </VBox>
                </VBox>

                <!-- UAV Status Grid - Card Style -->
                <VBox styleClass="lp-section">
                  <HBox styleClass="lp-section-head" alignment="CENTER_LEFT">
                    <Label text="无人机状态" styleClass="lp-title"/>
                  </HBox>
                  <VBox styleClass="lp-section-body">
                    <GridPane fx:id="droneStatusGrid" styleClass="uav-status-grid" hgap="1" vgap="1"/>
                  </VBox>
                </VBox>

                <!-- Waypoint List - Enhanced -->
                <VBox styleClass="lp-section" VBox.vgrow="ALWAYS">
                  <HBox styleClass="lp-section-head" alignment="CENTER_LEFT">
                    <Label text="航点列表" styleClass="lp-title"/>
                    <Label fx:id="uploadStatusBadge" text="已同步" styleClass="upload-status,synced"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="wpCountLabel" text="0 航点" styleClass="wp-count"/>
                  </HBox>
                  <VBox styleClass="lp-section-body" VBox.vgrow="ALWAYS">
                    <ListView fx:id="wpListView" VBox.vgrow="ALWAYS" styleClass="wp-list"/>
                  </VBox>
                </VBox>

                <!-- Mission Operations - Enhanced -->
                <VBox styleClass="lp-section">
                  <HBox styleClass="lp-section-head" alignment="CENTER_LEFT">
                    <Label text="任务操作" styleClass="lp-title"/>
                  </HBox>
                  <VBox styleClass="lp-section-body" spacing="6">
                    <VBox spacing="4">
                      <Button text="导入 XML" onAction="#onImportXml" styleClass="mo-btn"><graphic><SVGPath content="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" styleClass="svg-line,svg-12"/></graphic></Button>
                      <Button text="导出 XML" onAction="#onExportXml" styleClass="mo-btn"><graphic><SVGPath content="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2zM17 21v-8H7v8M7 3v5h8" styleClass="svg-line,svg-12"/></graphic></Button>
                      <Button text="新增航点" onAction="#onAddWaypoint" styleClass="mo-btn,primary"><graphic><SVGPath content="M12 2a10 10 0 1 0 0.01 0zM12 8v8M8 12h8" styleClass="svg-line,svg-12"/></graphic></Button>
                      <Button text="删除航点" onAction="#onDeleteWaypoint" styleClass="mo-btn,danger"><graphic><SVGPath content="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" styleClass="svg-line,svg-12"/></graphic></Button>
                      <Button text="路径预览" onAction="#onPreviewPath" styleClass="mo-btn"><graphic><SVGPath content="M5 3L19 12L5 21z" styleClass="svg-fill,svg-12"/></graphic></Button>
                      <Button text="冲突检测" onAction="#onCheckConflicts" styleClass="mo-btn"><graphic><SVGPath content="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" styleClass="svg-line,svg-12"/></graphic></Button>
                      <Button text="空域校验" onAction="#onAirspaceCheck" styleClass="mo-btn"><graphic><SVGPath content="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM12 8v8M8 12h8" styleClass="svg-line,svg-12"/></graphic></Button>
                      <Button text="路径优化" onAction="#onOptimizePath" styleClass="mo-btn,primary"><graphic><SVGPath content="M13 2L3 14h7l-1 8 10-12h-7z" styleClass="svg-fill,svg-12"/></graphic></Button>
                    </VBox>
                    <VBox styleClass="gated-section" spacing="4">
                      <Button fx:id="uploadE1Btn" text="上传至 E1" disable="true" styleClass="mo-btn,gated">
                        <tooltip><Tooltip text="门控：需切换至 E1 实机模式并建立连接"/></tooltip>
                        <graphic><SVGPath content="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" styleClass="svg-line,svg-12"/></graphic>
                      </Button>
                      <Button fx:id="autoMissionBtn" text="开始自动任务" disable="true" styleClass="mo-btn,gated">
                        <tooltip><Tooltip text="门控：需先上传航点至飞控，且飞行器解锁"/></tooltip>
                        <graphic><SVGPath content="M5 3L19 12L5 21z" styleClass="svg-fill,svg-12"/></graphic>
                      </Button>
                    </VBox>
                    <VBox styleClass="stat-section" spacing="4">
                      <HBox styleClass="stat-row">
                        <Label text="总航程" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalDistLabel" text="0.00 km" styleClass="stat-value"/>
                        <Label text="系统" styleClass="src-tag,system" style="-fx-padding: 0 3; -fx-font-size: 8px;"/>
                      </HBox>
                      <HBox styleClass="stat-row">
                        <Label text="预计耗时" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="estTimeLabel" text="--" styleClass="stat-value"/>
                        <Label text="系统" styleClass="src-tag,system" style="-fx-padding: 0 3; -fx-font-size: 8px;"/>
                      </HBox>
                      <HBox styleClass="stat-row">
                        <Label text="冲突检测" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="conflictLabel" text="无航点" styleClass="stat-value"/>
                        <Label text="系统" styleClass="src-tag,system" style="-fx-padding: 0 3; -fx-font-size: 8px;"/>
                      </HBox>
                      <HBox styleClass="stat-row">
                        <Label text="空域校验" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="airspaceStatusLabel" text="未校验" styleClass="aspace-status,idle"/>
                        <Label text="系统" styleClass="src-tag,system" style="-fx-padding: 0 3; -fx-font-size: 8px;"/>
                      </HBox>
                    </VBox>
                    <!-- Control Test Panel - Enhanced -->
                    <VBox fx:id="ctrlPanel" styleClass="ctrl-panel" visible="false" managed="false">
                      <HBox styleClass="ctrl-title" alignment="CENTER_LEFT">
                        <Label text="控制测试（仅限无桨/架台）">
                        <graphic><SVGPath content="M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6M12 1v3M12 20v3M1 12h3M20 12h3M4.5 4.5l2 2M17.5 17.5l2 2M4.5 19.5l2-2M17.5 6.5l2-2" styleClass="svg-line,svg-12"/></graphic>
                      </Label>
                      </HBox>
                      <GridPane styleClass="ctrl-grid" hgap="6" vgap="6">
                        <Button fx:id="armBtn" text="解锁" styleClass="ctrl-btn,arm" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Button fx:id="disarmBtn" text="急停/上锁" styleClass="ctrl-btn,disarm" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button text="手动模式" styleClass="ctrl-btn" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Button text="自稳模式" styleClass="ctrl-btn" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                      </GridPane>
                      <Label fx:id="ctrlStatusLabel" text="实机只读 · 需进入控制测试" styleClass="ctrl-status"/>
                    </VBox>
                  </VBox>
                </VBox>
              </VBox>
            </ScrollPane>
          </VBox>

          <!-- Center Map - Enhanced with floating controls -->
          <AnchorPane fx:id="mapContainer" styleClass="map-container">
            <!-- Map Canvas will be added programmatically -->

            <!-- Map control bar (top-left) -->
            <HBox fx:id="mapCtrlBar" styleClass="map-ctrl-bar" AnchorPane.leftAnchor="112" AnchorPane.topAnchor="10">
              <ToggleButton fx:id="btnFollow" text="跟随" selected="true" styleClass="map-ctrl-btn" onAction="#onToggleFollow"/>
              <ToggleButton fx:id="btnTrajectory" text="轨迹" selected="true" styleClass="map-ctrl-btn" onAction="#onToggleTrajectory"/>
            </HBox>

            <!-- Map toolbar (top-right) -->
            <HBox fx:id="mapToolbar" styleClass="map-toolbar" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
              <Button styleClass="map-tool-btn" onAction="#onToggleDataSourceDrawer" fx:id="btnDataSource">
                <tooltip><Tooltip text="数据源"/></tooltip>
                <graphic><SVGPath content="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16zM3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" styleClass="svg-line,svg-14"/></graphic>
              </Button>
              <Button styleClass="map-tool-btn" onAction="#onFitWaypoints">
                <tooltip><Tooltip text="适配视图"/></tooltip>
                <graphic><SVGPath content="M4 9V4H9M15 4H20V9M20 15V20H15M9 20H4V15" styleClass="svg-line,svg-14"/></graphic>
              </Button>
              <Region styleClass="tb-divider"/>
              <Button styleClass="map-tool-btn" onAction="#onZoomIn">
                <tooltip><Tooltip text="放大"/></tooltip>
                <graphic><SVGPath content="M11 4a7 7 0 1 0 0 14a7 7 0 0 0 0-14zM21 21l-4.35-4.35M8 11h6M11 8v6" styleClass="svg-line,svg-14"/></graphic>
              </Button>
              <Button styleClass="map-tool-btn" onAction="#onZoomOut">
                <tooltip><Tooltip text="缩小"/></tooltip>
                <graphic><SVGPath content="M11 4a7 7 0 1 0 0 14a7 7 0 0 0 0-14zM21 21l-4.35-4.35M8 11h6" styleClass="svg-line,svg-14"/></graphic>
              </Button>
              <Region styleClass="tb-divider"/>
              <ToggleButton styleClass="map-tool-btn" fx:id="btnMapStyle" onAction="#onToggleMapStyle">
                <tooltip><Tooltip text="切换底图"/></tooltip>
                <graphic><SVGPath content="M9 2L3 14L9 14L6 22L21 7L15 7L18 2z" styleClass="svg-fill,svg-14"/></graphic>
              </ToggleButton>
              <ToggleButton styleClass="map-tool-btn" selected="true" fx:id="btnAirspace" onAction="#onToggleAirspaceLayer">
                <tooltip><Tooltip text="空域图层"/></tooltip>
                <graphic><SVGPath content="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM12 8v8M8 12h8" styleClass="svg-line,svg-14"/></graphic>
              </ToggleButton>
            </HBox>

            <!-- Map hint (bottom-center) -->
            <HBox AnchorPane.bottomAnchor="8" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" alignment="CENTER">
              <Label fx:id="mapHint" text="点击地图添加航点 · 拖动调整位置 · 左侧面板管理任务" styleClass="map-hint"/>
            </HBox>

            <!-- Sensor entry (bottom-right) -->
            <HBox styleClass="sensor-entry" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="8">
              <VBox styleClass="sensor-entry-item" onMouseClicked="#onSensorEntryClick">
                <HBox spacing="4" alignment="CENTER">
                  <Region styleClass="se-dot" style="-fx-background-color: #fb7185;"/>
                  <Label text="温度" styleClass="se-label"/>
                  <Label fx:id="seTemp" text="26.5°C" styleClass="se-val"/>
                </HBox>
              </VBox>
              <VBox styleClass="sensor-entry-item" onMouseClicked="#onSensorEntryClick">
                <HBox spacing="4" alignment="CENTER">
                  <Region styleClass="se-dot" style="-fx-background-color: #34d399;"/>
                  <Label text="湿度" styleClass="se-label"/>
                  <Label fx:id="seHum" text="65%" styleClass="se-val"/>
                </HBox>
              </VBox>
              <VBox styleClass="sensor-entry-item" onMouseClicked="#onSensorEntryClick">
                <HBox spacing="4" alignment="CENTER">
                  <Region styleClass="se-dot" style="-fx-background-color: #22d3ee;"/>
                  <Label text="气压" styleClass="se-label"/>
                  <Label fx:id="sePres" text="1013.2" styleClass="se-val"/>
                </HBox>
              </VBox>
            </HBox>

            <!-- Drone HUD Card (top-center) - hidden by default, toggle via View menu -->
            <HBox fx:id="hudContainer" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" alignment="CENTER" visible="false" managed="false">
              <VBox fx:id="droneHud" styleClass="drone-hud">
                <HBox spacing="16" alignment="CENTER">
                <VBox alignment="CENTER" spacing="1">
                  <Label fx:id="hudAlt" text="86.0 m" styleClass="hud-val"/>
                  <Label text="高度" styleClass="hud-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="1">
                  <Label fx:id="hudSpeed" text="8.0 m/s" styleClass="hud-val"/>
                  <Label text="地速" styleClass="hud-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="1">
                  <Label fx:id="hudHdg" text="0°" styleClass="hud-val"/>
                  <Label text="航向" styleClass="hud-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="1">
                  <Label fx:id="hudBat" text="72%" styleClass="hud-val,hud-ok"/>
                  <Label text="电量" styleClass="hud-label"/>
                </VBox>
              </HBox>
              </VBox>
            </HBox>

            <!-- Data Source Drawer (initially hidden) -->
            <VBox fx:id="dsDrawer" styleClass="ds-drawer" visible="false" managed="false" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="46">
              <HBox styleClass="ds-drawer-head" alignment="CENTER_LEFT">
                <Label text="数据源状态">
