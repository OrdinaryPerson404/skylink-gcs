                  </ToggleButton>
                  <ToggleButton text="限飞区" styleClass="aspace-layer-chip" selected="true">
                    <graphic><Region styleClass="lc-dot" style="-fx-background-color: #f59e0b;"/></graphic>
                  </ToggleButton>
                  <ToggleButton text="临时限制" styleClass="aspace-layer-chip" selected="true">
