            <VBox spacing="8">
              <HBox spacing="8">
                <VBox styleClass="settings-field" HBox.hgrow="ALWAYS"><Label text="无人机型号" styleClass="settings-field-label"/><ComboBox fx:id="droneModelCombo" maxWidth="200"/></VBox>
                <VBox styleClass="settings-field"><Label text="最大航程 (m)" styleClass="settings-field-label"/><TextField fx:id="droneRangeField" maxWidth="100"/></VBox>
              </HBox>
              <VBox styleClass="settings-field">
                <Label text="搭载传感器" styleClass="settings-field-label"/>
                <HBox spacing="10" styleClass="sensor-chk-row">
                  <CheckBox fx:id="chkGps" text="GPS" selected="true" styleClass="sensor-chk"/>
                  <CheckBox fx:id="chkCompass" text="罗盘" selected="true" styleClass="sensor-chk"/>
                  <CheckBox fx:id="chkBarometer" text="气压计" selected="true" styleClass="sensor-chk"/>
                  <CheckBox fx:id="chkImu" text="IMU" selected="true" styleClass="sensor-chk"/>
                  <CheckBox fx:id="chkOpticalFlow" text="光流" selected="false" styleClass="sensor-chk"/>
                  <CheckBox fx:id="chkLidar" text="激光雷达" selected="false" styleClass="sensor-chk"/>
                </HBox>
                <Label text="选择无人机搭载的传感器类型，影响数据通道和算法输入" styleClass="settings-hint"/>
              </VBox>
              <Button text="保存设置" onAction="#onSaveSettings" styleClass="mo-btn,primary" style="-fx-pref-width: 100;"/>
            </VBox>
          </VBox>
        </VBox>
      </ScrollPane>
    </Tab>

    <!-- ===== Tab 4: 算法分析 - Enhanced ===== -->
    <Tab fx:id="algoTab" closable="false">
      <graphic><SVGPath content="M13 2L3 14h7l-1 8 10-12h-7z" styleClass="svg-line,svg-14"/></graphic>
      <text>算法分析</text>
      <FlowPane fx:id="algoFlow" hgap="16" vgap="16" alignment="TOP_CENTER" prefWrapLength="1000" style="-fx-padding: 20px;">
        <VBox styleClass="algo-card" prefWidth="480" maxWidth="500">
          <HBox styleClass="algo-card-head" alignment="CENTER_LEFT">
            <Label text="路径优化分析" styleClass="algo-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="贪婪算法 · Nearest Neighbor" styleClass="algo-sub"/>
          </HBox>
          <VBox styleClass="algo-card-body" spacing="10">
            <HBox styleClass="algo-compare" spacing="12">
              <VBox styleClass="algo-compare-item" HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="原始路径" styleClass="algo-compare-label"/>
                <Label fx:id="algoOrigDist" text="— km" styleClass="algo-compare-val,original"/>
              </VBox>
              <VBox styleClass="algo-compare-item" HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="优化路径" styleClass="algo-compare-label"/>
                <Label fx:id="algoOptDist" text="— km" styleClass="algo-compare-val,optimized"/>
              </VBox>
            </HBox>
            <HBox styleClass="algo-stat-row"><Label text="航点数量"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="algoWpCount" text="0" styleClass="algo-stat-val"/></HBox>
            <HBox styleClass="algo-stat-row"><Label text="航程变化"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="algoDelta" text="—" styleClass="algo-stat-val"/></HBox>
            <HBox styleClass="algo-stat-row"><Label text="优化率"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="algoRate" text="—" styleClass="algo-stat-val,improved"/></HBox>
            <Button text="执行路径优化" onAction="#onOptimizePath" styleClass="mo-btn,primary"><graphic><SVGPath content="M13 2L3 14h7l-1 8 10-12h-7z" styleClass="svg-fill,svg-12"/></graphic></Button>
          </VBox>
        </VBox>
        <VBox styleClass="algo-card" prefWidth="480" maxWidth="500">
          <HBox styleClass="algo-card-head" alignment="CENTER_LEFT">
            <Label text="续航预测" styleClass="algo-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="线性回归模型" styleClass="algo-sub"/>
            <Label text="API" styleClass="src-tag,api" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-padding: 1 6; -fx-background-radius: 3; -fx-background-color: #f59e0b; -fx-text-fill: #1a1a1a; -fx-margin: 0 0 0 6;"/>
          </HBox>
          <VBox styleClass="algo-card-body" spacing="10">
            <HBox styleClass="algo-input-row" alignment="CENTER_LEFT">
              <Label text="飞行距离" styleClass="algo-input-label"/>
              <TextField fx:id="distInput" text="5.0" maxWidth="120"/>
              <Label text="km" style="-fx-font-size: 11px; -fx-text-fill: #8b949e;"/>
            </HBox>
            <HBox styleClass="algo-input-row" alignment="CENTER_LEFT">
              <Label text="载重" styleClass="algo-input-label"/>
              <TextField fx:id="loadInput" text="1.0" maxWidth="120"/>
              <Label text="kg" style="-fx-font-size: 11px; -fx-text-fill: #8b949e;"/>
            </HBox>
            <HBox styleClass="algo-input-row" alignment="CENTER_LEFT">
              <Label text="风速" styleClass="algo-input-label"/>
              <TextField fx:id="windInput" text="3.0" maxWidth="100"/>
              <Label text="m/s" style="-fx-font-size: 11px; -fx-text-fill: #8b949e;"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Button text="获取 API 风速" onAction="#onFetchWindApi" styleClass="algo-api-btn"/>
            </HBox>
            <HBox styleClass="algo-compare" spacing="12">
              <VBox styleClass="algo-compare-item" HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="预测续航" styleClass="algo-compare-label"/>
                <Label fx:id="enduranceResult" text="—" styleClass="algo-compare-val,optimized"/>
              </VBox>
              <VBox styleClass="algo-compare-item" HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="预计耗电" styleClass="algo-compare-label"/>
                <Label fx:id="costResult" text="—" styleClass="algo-compare-val,original"/>
              </VBox>
            </HBox>
            <Button text="预测续航" onAction="#onPredictBattery" styleClass="mo-btn,primary"><graphic><SVGPath content="M2 7h16v10H2zM6 7V4h8v3" styleClass="svg-line,svg-12"/></graphic></Button>
          </VBox>
        </VBox>
      </FlowPane>
    </Tab>
  </TabPane>
</VBox>
