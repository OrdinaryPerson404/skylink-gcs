            </VBox>
          </SplitPane>
        </VBox>
        </StackPane>
      </VBox>
    </Tab>

    <!-- ===== Tab 3: 系统设置 ===== -->
    <Tab fx:id="settingsTab" closable="false">
      <graphic><SVGPath content="M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6M12 1v3M12 20v3M1 12h3M20 12h3M4.5 4.5l2 2M17.5 17.5l2 2M4.5 19.5l2-2M17.5 6.5l2-2" styleClass="svg-line,svg-14"/></graphic>
